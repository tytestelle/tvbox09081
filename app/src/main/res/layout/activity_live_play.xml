<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/live_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <!-- ========== 视频层 ========== -->
    <xyz.doikki.videoplayer.player.VideoView
        android:id="@+id/mVideoView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 切台截图层 -->
    <FrameLayout
        android:id="@+id/switchChannelSnapshotOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:background="@android:color/black">

        <ImageView
            android:id="@+id/switchChannelSnapshotImage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter" />
    </FrameLayout>

    <!-- ========== 酷9：全屏手势触摸层 ========== -->
    <View
        android:id="@+id/gesture_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/transparent"
        android:clickable="true"
        android:focusable="true" />

    <!-- ========== 顶部信息 ========== -->
    <TextView
        android:id="@+id/tvChannel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="30dp"
        android:layout_marginEnd="60dp"
        android:textColor="@android:color/white"
        android:textSize="16sp"
        android:visibility="invisible" />

    <TextView
        android:id="@+id/tvTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_marginStart="60dp"
        android:layout_marginTop="30dp"
        android:textColor="@android:color/white"
        android:textSize="16sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tvNetSpeed"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_marginStart="60dp"
        android:layout_marginTop="60dp"
        android:textColor="@android:color/white"
        android:textSize="14sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tvResolution"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="60dp"
        android:layout_marginEnd="60dp"
        android:textColor="@android:color/white"
        android:textSize="14sp"
        android:visibility="gone" />

    <!-- ========== 左侧频道列表（酷9风格，三列） ========== -->
    <LinearLayout
        android:id="@+id/tvLeftChannnelListLayout"
        android:layout_width="@dimen/vs_760"
        android:layout_height="@dimen/vs_650"
        android:layout_gravity="start|top"
        android:layout_marginStart="@dimen/vs_64"
        android:layout_marginTop="@dimen/vs_17_ku9"
        android:orientation="horizontal"
        android:visibility="invisible"
        android:padding="0dp"
        android:background="@drawable/bg_ku9_panel">

        <!-- 第一列：源列表（我的收藏/自定义源） -->
        <com.owen.tvrecyclerview.widget.TvRecyclerView
            android:id="@+id/mSourceListView"
            android:layout_width="@dimen/vs_72"
            android:layout_height="match_parent"
            android:padding="4dp" />

        <!-- 第二列：分组列表 -->
        <com.owen.tvrecyclerview.widget.TvRecyclerView
            android:id="@+id/mGroupGridView"
            android:layout_width="@dimen/vs_108_ku9"
            android:layout_height="match_parent"
            android:padding="4dp" />

        <!-- 第三列：频道列表 -->
        <com.owen.tvrecyclerview.widget.TvRecyclerView
            android:id="@+id/mChannelGridView"
            android:layout_width="@dimen/vs_520_ku9"
            android:layout_height="match_parent"
            android:layout_weight="0"
            android:padding="4dp" />

        <!-- 酷9：节目单入口，放在三列最右侧 -->
        <TextView
            android:id="@+id/btn_ku9_program_guide"
            android:layout_width="@dimen/vs_60_ku9"
            android:layout_height="match_parent"
            android:gravity="center"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:text="节目单&#10;»"
            android:textColor="#FFFFFFFF"
            android:textSize="18sp"
            android:lineSpacingExtra="4dp"
            android:focusable="true"
            android:clickable="true"
            android:background="@drawable/selector_ku9_button" />

        <TextView
            android:id="@+id/tv_current_source_name"
            android:layout_width="1dp"
            android:layout_height="1dp"
            android:visibility="gone"
            tools:text="当前源：测试源" />
    </LinearLayout>

    <!-- ========== 酷9独立节目单窗口 ========== -->
    <include layout="@layout/ku9_program_guide" />

    <!-- ========== 右侧设置面板（保持不变） ========== -->
    <LinearLayout
        android:id="@+id/tvRightSettingLayout"
        android:layout_width="400dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:orientation="horizontal"
        android:visibility="invisible"
        android:background="#CC000000">

        <com.owen.tvrecyclerview.widget.TvRecyclerView
            android:id="@+id/mSettingGroupView"
            android:layout_width="160dp"
            android:layout_height="match_parent"
            android:padding="8dp" />

        <com.owen.tvrecyclerview.widget.TvRecyclerView
            android:id="@+id/mSettingItemView"
            android:layout_width="240dp"
            android:layout_height="match_parent"
            android:padding="8dp" />
    </LinearLayout>

    <!-- ========== 酷9风格底部信息栏：紧凑悬浮卡片 ========== -->
    <LinearLayout
        android:id="@+id/ll_bottom_info_bar"
        android:layout_width="@dimen/vs_800_ku9"
        android:layout_height="@dimen/vs_130_ku9"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="@dimen/vs_17_ku9"
        android:orientation="horizontal"
        android:visibility="gone"
        android:gravity="center_vertical"
        android:background="@drawable/bg_ku9_panel"
        android:paddingStart="@dimen/vs_8"
        android:paddingEnd="@dimen/vs_8"
        android:paddingTop="@dimen/vs_8"
        android:paddingBottom="@dimen/vs_8">

        <FrameLayout
            android:layout_width="@dimen/vs_72"
            android:layout_height="@dimen/vs_72">
            <ImageView
                android:id="@+id/img_live_icon"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerInside" />
            <FrameLayout
                android:id="@+id/live_icon_null_bg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/shape_circle_gray"
                android:visibility="invisible">
                <TextView
                    android:id="@+id/live_icon_null_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:textColor="@android:color/white"
                    android:textSize="18sp" />
            </FrameLayout>
        </FrameLayout>

        <LinearLayout
            android:layout_width="@dimen/vs_160"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:orientation="vertical">
            <TextView
                android:id="@+id/tv_channel_bar_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@android:color/white"
                android:textSize="@dimen/ts_24" />
            <TextView
                android:id="@+id/tv_channel_bottom_number"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#AAAAAA"
                android:textSize="@dimen/ts_18" />
            <TextView
                android:id="@+id/tv_source"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#888888"
                android:textSize="@dimen/ts_16" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:orientation="vertical">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/tv_current_program_time"
                    android:layout_width="@dimen/vs_120"
                    android:layout_height="wrap_content"
                    android:textColor="#FFFFFFFF"
                    android:textSize="@dimen/ts_18" />
                <TextView
                    android:id="@+id/tv_current_program_name"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="#FFFFFFFF"
                    android:textSize="14sp" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/tv_next_program_time"
                    android:layout_width="@dimen/vs_120"
                    android:layout_height="wrap_content"
                    android:textColor="#999999"
                    android:textSize="@dimen/ts_18" />
                <TextView
                    android:id="@+id/tv_next_program_name"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="#AAAAAA"
                    android:textSize="@dimen/ts_18" />
            </LinearLayout>
            <ProgressBar
                android:id="@+id/epg_progress_bar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:layout_marginTop="5dp"
                android:max="100"
                android:progress="0"
                android:progressDrawable="@drawable/epg_progress_drawable" />
            <TextView
                android:id="@+id/tv_desc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="#CCCCCC"
                android:textSize="@dimen/ts_16" />
        </LinearLayout>
    </LinearLayout>

    <!-- ========== 原有EPG底部栏（保留兼容） ========== -->
    <RelativeLayout
        android:id="@+id/ll_epg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:visibility="gone">

        <TextView
            android:id="@+id/tv_shownum"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone" />

        <TextView
            android:id="@+id/txtNoEpg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone" />

        <View
            android:id="@+id/divLoadEpg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone" />

        <View
            android:id="@+id/divLoadEpgDivider"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone" />

        <View
            android:id="@+id/divLoadEpgleft"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/divEPG"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:visibility="gone">

            <com.owen.tvrecyclerview.widget.TvRecyclerView
                android:id="@+id/mEpgDateGridView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone" />

            <com.owen.tvrecyclerview.widget.TvRecyclerView
                android:id="@+id/lv_epg"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_right_top_channel_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tv_right_top_epg_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/iv_circle_bg"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/iv_back_bg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone" />

        <View
            android:id="@+id/ll_right_top_loading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone" />

        <View
            android:id="@+id/ll_right_top_huikan"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tv_current_program"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tv_next_program"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone" />
    </RelativeLayout>

    <!-- ========== 回看控制器 ========== -->
    <RelativeLayout
        android:id="@+id/backcontroller"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <SeekBar
            android:id="@+id/pb_progressbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_marginBottom="80dp" />

        <TextView
            android:id="@+id/tv_currentpos"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_above="@id/pb_progressbar"
            android:layout_alignParentStart="true"
            android:textColor="@android:color/white" />

        <TextView
            android:id="@+id/tv_duration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_above="@id/pb_progressbar"
            android:layout_alignParentEnd="true"
            android:textColor="@android:color/white" />

        <View
            android:id="@+id/iv_playpause"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_centerInParent="true"
            android:background="@drawable/vod_pause" />

        <View
            android:id="@+id/iv_play"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_centerInParent="true"
            android:visibility="invisible"
            android:background="@drawable/icon_play" />
    </RelativeLayout>

    <!-- ========== 选台数字显示 ========== -->
    <TextView
        android:id="@+id/tv_selected_channel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:textColor="@android:color/white"
        android:textSize="48sp"
        android:visibility="invisible" />

</FrameLayout>
