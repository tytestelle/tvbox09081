<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ku9_program_guide"
    android:layout_width="@dimen/vs_760"
    android:layout_height="@dimen/vs_650"
    android:layout_gravity="start|top"
    android:layout_marginStart="@dimen/vs_64"
    android:layout_marginTop="@dimen/vs_17_ku9"
    android:background="@drawable/bg_ku9_panel"
    android:elevation="18dp"
    android:visibility="gone"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:padding="0dp">

        <com.owen.tvrecyclerview.widget.TvRecyclerView
            android:id="@+id/ku9GuideChannelList"
            android:layout_width="@dimen/vs_380"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingTop="4dp"
            android:paddingBottom="4dp" />

        <com.owen.tvrecyclerview.widget.TvRecyclerView
            android:id="@+id/ku9GuideDateList"
            android:layout_width="@dimen/vs_88"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingTop="4dp"
            android:paddingBottom="4dp" />

        <com.owen.tvrecyclerview.widget.TvRecyclerView
            android:id="@+id/ku9GuideProgramList"
            android:layout_width="@dimen/vs_292"
            android:layout_height="match_parent"
            android:layout_weight="0"
            android:clipToPadding="false"
            android:paddingTop="4dp"
            android:paddingBottom="4dp" />
    </LinearLayout>
</FrameLayout>
