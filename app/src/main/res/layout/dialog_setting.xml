<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="@dimen/vs_20"
    android:background="@drawable/shape_live_setting_dialog_bg">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/tvSettingTitle"
        android:text="订阅配置"
        android:textColor="#FFFFFF"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"/>

    <!-- 列表订阅 -->
    <LinearLayout
        android:id="@+id/rowLiveSubscription"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingVertical="10dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="列表订阅"
            android:textColor="#FFFFFF"
            android:textSize="16sp"/>

        <TextView
            android:id="@+id/tvLiveStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="未配置"
            android:textColor="#999999"
            android:textSize="14sp"
            android:layout_marginEnd="12dp"/>

        <TextView
            android:id="@+id/tvLiveSub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="打开"
            android:textColor="#1890FF"
            android:textSize="14sp"
            android:paddingHorizontal="12dp"
            android:paddingVertical="4dp"
            android:background="@drawable/shape_button_bg"
            android:layout_marginEnd="8dp"/>

        <TextView
            android:id="@+id/tvLiveClear"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="清除"
            android:textColor="#999999"
            android:textSize="14sp"
            android:paddingHorizontal="12dp"
            android:paddingVertical="4dp"
            android:background="@drawable/shape_button_bg"/>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#333333"
        android:layout_marginVertical="4dp"/>

    <!-- EPG订阅 -->
    <LinearLayout
        android:id="@+id/rowEpgSubscription"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingVertical="10dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="EPG订阅"
            android:textColor="#FFFFFF"
            android:textSize="16sp"/>

        <TextView
            android:id="@+id/tvEpgStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="未配置"
            android:textColor="#999999"
            android:textSize="14sp"
            android:layout_marginEnd="12dp"/>

        <TextView
            android:id="@+id/tvEpgSub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="打开"
            android:textColor="#1890FF"
            android:textSize="14sp"
            android:paddingHorizontal="12dp"
            android:paddingVertical="4dp"
            android:background="@drawable/shape_button_bg"
            android:layout_marginEnd="8dp"/>

        <TextView
            android:id="@+id/tvEpgClear"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="清除"
            android:textColor="#999999"
            android:textSize="14sp"
            android:paddingHorizontal="12dp"
            android:paddingVertical="4dp"
            android:background="@drawable/shape_button_bg"/>
    </LinearLayout>

</LinearLayout>
